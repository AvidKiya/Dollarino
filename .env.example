# ==============================================================================
# Dollarino (دلارینو) V10.1 — Production Secrets & Environment Template
# Copy to `.dev.vars` for local Wrangler (`wrangler dev`) — NEVER commit real secrets!
# For production on Cloudflare Workers, push with: `npx wrangler secret put <KEY>`
# ==============================================================================

# --- Core Auth & AES-GCM Vault Encryption (REQUIRED) ---
SESSION_JWT_SECRET=replace_with_64_char_random_hex
MASTER_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# --- Instance Owner & Official Telegram Channels ---
OWNER_TELEGRAM_ID=944021185
DEFAULT_SIGNAL_CHANNEL=@Dollarino_official
PUBLIC_WEB_URL=https://dollarino-worker.your-subdomain.workers.dev

# --- AI Gateway (Hilinkup / DeepSeek / OpenAI-compatible) ---
HILINKUP_API_KEY=replace_with_your_hilinkup_api_key
HILINKUP_BASE_URL=https://api.hilinkup.com/v1/chat/completions
HILINKUP_MODEL=baidu/deepseek-v4.1-flash-1017

# --- Global Instance Telegram Bot (@BotFather token) ---
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret

# --- Production Live Trading & Risk Guardrails ---
ALLOW_LIVE_TRADING=true
MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MARGIN_PCT=10.0
MIN_RISK_REWARD=1.0
DAILY_MAX_LOSS_PCT=5.0
