{
  "manifest_version": 3,
  "name": "Dollarino — پایانه و رادار هوشمند دلارینو",
  "short_name": "Dollarino",
  "version": "11.6.0",
  "description": "Dollarino V11.6 Companion: Simple-Mode Bot & 5-Engine Controls, Demo/Live & 24/7 Auto Toggles, Live USD/IRT Ticks, AI DEX Analyzer & Trust Wallet Radar.",
  "icons": {
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "دلارینو | ترمینال سریع و هوشمند V11.6",
    "default_icon": {
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.pages.dev/*",
    "https://*.workers.dev/*",
    "https://*.e2b.app/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://api.coinbase.com/*"
  ]
}
