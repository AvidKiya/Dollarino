{
  "manifest_version": 3,
  "name": "Dollarino — پایانه ساده در پنل کناری",
  "short_name": "Dollarino",
  "version": "11.7.2",
  "description": "Dollarino V11.7.2 Chrome Side Panel Companion: Opens Dollarino Simple Mode docked inside the browser window just like Trust Wallet.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "دلارینو | باز کردن حالت ساده در پنل کناری مرورگر",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-512.png"
    }
  },
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
