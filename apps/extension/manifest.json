{
  "manifest_version": 3,
  "name": "Dollarino Companion — ترمینال سریع و رادار DEX دلارینو",
  "short_name": "Dollarino",
  "version": "9.6.0",
  "description": "Apple Liquid-Glass Quick Trading Companion: Bot Control, Kill Switch, AI Scan, Live Markets, DexScreener & Trust Wallet Swap, and Referral Hub.",
  "icons": {
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dollarino Pro Companion",
    "default_icon": {
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.pages.dev/*",
    "https://*.workers.dev/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*"
  ]
}
