{
  "manifest_version": 3,
  "name": "Dollarino V11.9.1 for Edge — حالت ساده و ترید هوشمند",
  "short_name": "Dollarino",
  "version": "11.7.2",
  "version_name": "11.9.1",
  "minimum_edge_version": "114",
  "description": "اکستنشن Microsoft Edge دلارینو V11.9.1 — حالت ساده کامل در Side Panel، ثبت‌نام و ورود، ۵ موتور همزمان، تراز ۵ بخش و اسنایپر DEX.",
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-512.png"
  },
  "action": {
    "default_title": "باز کردن حالت ساده دلارینو V11.9.1",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-512.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
