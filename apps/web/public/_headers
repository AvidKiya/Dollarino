/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: all

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/dollarino-preview.jpg
  Content-Type: image/jpeg
  Access-Control-Allow-Origin: *
